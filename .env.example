# Keep real values in an uncommitted .env.local file or in the deployment environment.
# Do not commit secrets, access tokens, or OAuth credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required only when Studio submission is deliberately enabled.
SUPABASE_SECRET_KEY=
STUDIO_SUBMISSION_ENABLED=false
STUDIO_PRIVACY_POLICY_VERSION=
STUDIO_CAPABILITIES_JSON=
STUDIO_RATE_LIMIT_SECRET=
CRON_SECRET=

# Google OAuth for account-backed carts. Register the approved callback URLs in Google:
# https://printaway.vercel.app/api/auth/callback/google
# https://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Local: https://localhost:3000. Production: https://printaway.vercel.app
NEXTAUTH_URL=

# Square server configuration. Every value below must belong to the same Square
# environment and merchant account. A Sandbox token cannot read a production
# catalog (or another Sandbox merchant's catalog), and variation IDs are not portable.
# The access token needs Square Catalog and Inventory read access. Inventory is read
# using the variation IDs below.
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=
SQUARE_MONITOR_RISER_VARIATION_ID=
SQUARE_DESK_TRAY_VARIATION_ID=
SQUARE_COAT_HANGER_VARIATION_ID=
SQUARE_KEYCAP_FIDGET_VARIATION_ID=
# Shared Print Finish modifier options attached to every Shop item. Enter the
# individual Square modifier IDs, not the parent modifier-list ID.
SQUARE_PRINT_FINISH_MATTE_MODIFIER_ID=
SQUARE_PRINT_FINISH_GLOSSY_MODIFIER_ID=
SQUARE_CHECKOUT_ENABLED=false
# Local: https://localhost:3000/checkout/return
# Production: https://printaway.vercel.app/checkout/return
SQUARE_CHECKOUT_RETURN_URL=
# Must exactly match the Square webhook subscription notification URL.
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=
